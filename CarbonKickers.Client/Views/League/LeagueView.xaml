<UserControl
    x:Class="CarbonKickers.Client.Views.League.LeagueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,36">
            <Grid>
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="WEEKLY LEAGUE" />

            </Grid>
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Leagues run Monday to Sunday. Your next week's tier is based on your total Green XP; standings are based on CO₂ saved this week." />

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  This week's standings  -->
                <ContentControl VerticalAlignment="Top" Style="{StaticResource ArcadePanel}">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Rectangle
                                    x:Name="LeagueDot"
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="LeagueTitleText"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.GameHeading}"
                                    Text="BRONZE LEAGUE" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DaysLeftText"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.GameMuted}"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="NoLeagueText"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                Style="{StaticResource Text.Error}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>



                        <Grid Margin="16,20,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource Brush.GameMuted}"
                                Text="Rank" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource Brush.GameMuted}"
                                Text="Player" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{StaticResource Brush.GameMuted}"
                                Text="XP this week" />
                        </Grid>

                        <ItemsControl x:Name="StandingsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!--  Zone divider  -->
                                        <Grid Margin="0,8,0,8" Visibility="{Binding DividerVisibility}">
                                            <Rectangle
                                                Height="1"
                                                VerticalAlignment="Center"
                                                Fill="{Binding DividerBrush}" />
                                            <Border
                                                Padding="10,0"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource Brush.Game}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding DividerBrush}"
                                                    Text="{Binding DividerText}" />
                                            </Border>
                                        </Grid>
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="16,11"
                                            Background="{Binding RowBackground}"
                                            BorderBrush="{Binding RowBorder}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{Binding RankBrush}"
                                                    Style="{StaticResource Text.Pixel}"
                                                    Text="{Binding RankText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="{Binding NameWeight}"
                                                    Foreground="{StaticResource Brush.GameText}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource Brush.Gold}"
                                                    Style="{StaticResource Text.Pixel}"
                                                    Text="{Binding XpText}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <!--  Tier ladder  -->
                <ContentControl
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Style="{StaticResource ArcadePanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.GameHeading}" Text="TIERS" />
                        <TextBlock
                            x:Name="LadderSummaryText"
                            Margin="0,12,0,16"
                            Style="{StaticResource Text.GameMuted}" />
                        <ItemsControl x:Name="TiersItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="14,10"
                                        Background="{Binding RowBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="15"
                                                Height="21"
                                                HorizontalAlignment="Left"
                                                RenderOptions.EdgeMode="Aliased"
                                                Source="{StaticResource Sprite.Player}"
                                                Visibility="{Binding PlayerVisibility}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle
                                                        Width="10"
                                                        Height="10"
                                                        Fill="{Binding TierBrush}" />
                                                    <TextBlock
                                                        Margin="10,0,0,0"
                                                        FontSize="14"
                                                        FontWeight="{Binding NameWeight}"
                                                        Foreground="{StaticResource Brush.GameText}"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="20,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{StaticResource Brush.GameMuted}"
                                                    Text="{Binding RangeText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
