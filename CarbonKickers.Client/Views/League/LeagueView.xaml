<UserControl x:Class="CarbonKickers.Client.Views.League.LeagueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,36">
            <Grid>
                <TextBlock Text="WEEKLY LEAGUE" Style="{StaticResource Text.ScreenTitle}"/>
                <Border Style="{StaticResource PreviewTag}" HorizontalAlignment="Right">
                    <TextBlock Text="Preview · sample data" FontSize="12" Foreground="{StaticResource Brush.Danger}"/>
                </Border>
            </Grid>
            <TextBlock Text="Leagues run Monday to Sunday. Finish in the top 3 to move up a tier; the bottom 2 move down."
                       Style="{StaticResource Text.Subtitle}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- This week's standings -->
                <ContentControl Style="{StaticResource ArcadePanel}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="LeagueDot" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LeagueTitleText" Text="BRONZE LEAGUE" Style="{StaticResource Text.GameHeading}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DaysLeftText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource Text.GameMuted}" TextWrapping="NoWrap"/>
                        </Grid>

                        <Border x:Name="JoinBanner" Style="{StaticResource GameInset}" Margin="0,18,0,0" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="JoinTitleText" Text="This week's league is open." FontSize="14"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Every trip you log this week adds to your league score."
                                               Style="{StaticResource Text.GameMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="JOIN WEEKLY LEAGUE" Style="{StaticResource Button.GameSmall}"
                                        VerticalAlignment="Center" Click="JoinButton_Click"/>
                            </Grid>
                        </Border>

                        <Grid Margin="16,20,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rank" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                            <TextBlock Grid.Column="1" Text="Player" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                            <TextBlock Grid.Column="2" Text="XP this week" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                        </Grid>

                        <ItemsControl x:Name="StandingsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Zone divider -->
                                        <Grid Margin="0,8,0,8" Visibility="{Binding DividerVisibility}">
                                            <Rectangle Height="1" Fill="{Binding DividerBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource Brush.Game}" HorizontalAlignment="Center" Padding="10,0">
                                                <TextBlock Text="{Binding DividerText}" FontSize="12" Foreground="{Binding DividerBrush}"/>
                                            </Border>
                                        </Grid>
                                        <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}" BorderThickness="1" Padding="16,11" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding RankText}" Style="{StaticResource Text.Pixel}" Margin="0,3,0,0" FontSize="12"
                                                           Foreground="{Binding RankBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                           FontWeight="{Binding NameWeight}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.GameText}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding XpText}" Style="{StaticResource Text.Pixel}" Margin="0,3,0,0"
                                                           FontSize="11" Foreground="{StaticResource Brush.Gold}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <!-- Tier ladder -->
                <ContentControl Grid.Column="2" Style="{StaticResource ArcadePanel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="TIERS" Style="{StaticResource Text.GameHeading}"/>
                        <TextBlock x:Name="LadderSummaryText" Style="{StaticResource Text.GameMuted}" Margin="0,12,0,16"/>
                        <ItemsControl x:Name="TiersItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RowBackground}" Padding="14,10" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{StaticResource Sprite.Player}" Width="15" Height="21"
                                                   HorizontalAlignment="Left" Visibility="{Binding PlayerVisibility}"
                                                   RenderOptions.EdgeMode="Aliased"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="10" Height="10" Fill="{Binding TierBrush}"/>
                                                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14"
                                                               FontWeight="{Binding NameWeight}"
                                                               Foreground="{StaticResource Brush.GameText}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RangeText}" FontSize="12" Margin="20,2,0,0"
                                                           Foreground="{StaticResource Brush.GameMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
