<Window
    x:Class="CarbonKickers.Client.Views.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Carbon Kickers"
        Icon="pack://application:,,,/CarbonKickers.Client;component/Assets/Logo/app.ico"
    Width="1200"
    Height="760"
    MinWidth="1024"
    MinHeight="700"
    Background="{StaticResource Brush.Ground}"
    FontFamily="{StaticResource Font.Body}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource Brush.Ground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar  -->
        <Border Background="{StaticResource Brush.GameDeep}">
            <DockPanel>
                <StackPanel Margin="28,30,24,28" DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="16"
                        Foreground="{StaticResource Brush.Peach}"
                        Style="{StaticResource Text.Pixel}"
                        Text="CARBON" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="16"
                        Foreground="{StaticResource Brush.Coral}"
                        Style="{StaticResource Text.Pixel}"
                        Text="KICKERS" />
                </StackPanel>

                <!--  Player chip + log out  -->
                <StackPanel Margin="0,0,0,18" DockPanel.Dock="Bottom">
                    <Border
                        Margin="12,0,12,8"
                        Padding="12"
                        Background="{StaticResource Brush.Game}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="20"
                                Height="28"
                                Margin="0,0,12,0"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                RenderOptions.EdgeMode="Aliased"
                                Source="{StaticResource Sprite.Player}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="PlayerNameText"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Brush.GameText}"
                                    Text="Player"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PlayerXpText"
                                    Margin="0,6,0,0"
                                    FontSize="9"
                                    Foreground="{StaticResource Brush.Gold}"
                                    Style="{StaticResource Text.Pixel}"
                                    Text="0 XP" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button
                        Margin="24,8,0,0"
                        HorizontalAlignment="Left"
                        Click="LogOutButton_Click"
                        Foreground="{StaticResource Brush.GameMuted}"
                        Style="{StaticResource Button.Link}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource Icon.LogOut}"
                                Fill="{StaticResource Brush.GameMuted}"
                                RenderOptions.EdgeMode="Aliased"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontWeight="Normal"
                                Text="Log out" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton
                        x:Name="NavDashboard"
                        Checked="NavItem_Checked"
                        Content="Dashboard"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.Home}" />
                    <RadioButton
                        x:Name="NavLogTrip"
                        Checked="NavItem_Checked"
                        Content="Log a trip"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.LogTrip}" />
                    <RadioButton
                        x:Name="NavHistory"
                        Checked="NavItem_Checked"
                        Content="Trip history"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.History}" />
                    <RadioButton
                        x:Name="NavBadges"
                        Checked="NavItem_Checked"
                        Content="Badges"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.Badges}" />

                    <TextBlock
                        Margin="36,22,0,8"
                        FontSize="12"
                        Foreground="{StaticResource Brush.GameMuted}"
                        Text="Compete" />
                    <RadioButton
                        x:Name="NavLeaderboard"
                        Checked="NavItem_Checked"
                        Content="Leaderboard"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.Leaderboard}" />
                    <RadioButton
                        x:Name="NavLeague"
                        Checked="NavItem_Checked"
                        Content="Weekly league"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.League}" />
                    <RadioButton
                        x:Name="NavArena"
                        Checked="NavItem_Checked"
                        Content="Arena"
                        Style="{StaticResource NavItem}"
                        Tag="{StaticResource Icon.Arena}" />

                    <StackPanel x:Name="AdminNavSection" Visibility="Collapsed">
                        <TextBlock
                            Margin="36,22,0,8"
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="Administration" />

                        <RadioButton
                            x:Name="NavAdmin"
                            Checked="NavItem_Checked"
                            Content="Admin panel"
                            Style="{StaticResource NavItem}"
                            Tag="{StaticResource Icon.Home}" />
                    </StackPanel>
                </StackPanel>


            </DockPanel>
        </Border>

        <!--  The current screen  -->
        <ContentControl
            x:Name="ScreenHost"
            Grid.Column="1"
            Focusable="False" />
    </Grid>
</Window>
