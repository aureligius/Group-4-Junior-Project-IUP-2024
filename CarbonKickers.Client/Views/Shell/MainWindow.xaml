<Window x:Class="CarbonKickers.Client.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carbon Kickers"
        Width="1200"
        Height="760"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Ground}"
        FontFamily="{StaticResource Font.Body}"
        UseLayoutRounding="True">

    <Grid Background="{StaticResource Brush.Ground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Brush.GameDeep}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="28,30,24,28">
                    <TextBlock Text="CARBON" Style="{StaticResource Text.Pixel}" FontSize="16"
                               Foreground="{StaticResource Brush.Peach}"/>
                    <TextBlock Text="KICKERS" Style="{StaticResource Text.Pixel}" FontSize="16" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Coral}"/>
                </StackPanel>

                <!-- Player chip + log out -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                    <Border Margin="12,0,12,8" Padding="12" Background="{StaticResource Brush.Game}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{StaticResource Sprite.Player}" Width="20" Height="28" Margin="0,0,12,0"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerNameText" Text="Player" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.GameText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlayerXpText" Text="0 XP" Style="{StaticResource Text.Pixel}" FontSize="9"
                                           Margin="0,6,0,0" Foreground="{StaticResource Brush.Gold}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Click="LogOutButton_Click" Style="{StaticResource Button.Link}" Margin="24,8,0,0"
                            HorizontalAlignment="Left" Foreground="{StaticResource Brush.GameMuted}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.LogOut}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource Brush.GameMuted}" RenderOptions.EdgeMode="Aliased"/>
                            <TextBlock Text="Log out" Margin="10,0,0,0" FontWeight="Normal"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Home}"
                                 Content="Dashboard" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavLogTrip" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.LogTrip}"
                                 Content="Log a trip" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.History}"
                                 Content="Trip history" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavBadges" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Badges}"
                                 Content="Badges" Checked="NavItem_Checked"/>

                    <TextBlock Text="Compete" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"
                               Margin="36,22,0,8"/>
                    <RadioButton x:Name="NavLeaderboard" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Leaderboard}"
                                 Content="Leaderboard" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavLeague" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.League}"
                                 Content="Weekly league" Checked="NavItem_Checked"/>
                    <RadioButton x:Name="NavArena" Style="{StaticResource NavItem}" Tag="{StaticResource Icon.Arena}"
                                 Content="Arena" Checked="NavItem_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The current screen -->
        <ContentControl x:Name="ScreenHost" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
