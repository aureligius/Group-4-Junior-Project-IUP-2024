<UserControl
    x:Class="CarbonKickers.Client.Views.Arena.ArenaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  Head-to-head bar: the fill takes the bar's Foreground  -->
        <Style x:Key="VsBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{StaticResource Brush.Game}">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,36">
            <Grid>
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="THE ARENA" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click"
                    Content="REFRESH"
                    Style="{StaticResource Button.GameSmall}" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Challenge another player: whoever saves more CO₂ before the time runs out wins." />

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!--  Invites  -->
                    <ContentControl
                        x:Name="IncomingPanel"
                        Margin="0,0,0,20"
                        Style="{StaticResource ArcadePanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.GameHeading}" Text="CHALLENGES FOR YOU" />
                            <ItemsControl x:Name="IncomingItems" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Style="{StaticResource GameInset}">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="14">
                                                        <Run FontWeight="SemiBold" Text="{Binding Opponent, Mode=OneWay}" />
                                                        <Run Text="challenged you" />
                                                    </TextBlock>
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Style="{StaticResource Text.GameMuted}"
                                                        Text="{Binding Days, StringFormat='{}{0}-day battle'}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button
                                                        Click="AcceptButton_Click"
                                                        Content="ACCEPT"
                                                        Style="{StaticResource Button.GameSmall}"
                                                        Tag="{Binding}" />
                                                    <Button
                                                        Margin="8,0,0,0"
                                                        Click="DeclineButton_Click"
                                                        Content="DECLINE"
                                                        Style="{StaticResource Button.GameGhostSmall}"
                                                        Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>

                    <!--  Battles in progress  -->
                    <ContentControl Margin="0,0,0,20" Style="{StaticResource ArcadePanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.GameHeading}" Text="BATTLES IN PROGRESS" />
                            <TextBlock
                                x:Name="NoBattlesText"
                                Margin="0,16,0,0"
                                Style="{StaticResource Text.GameMuted}"
                                Text="No battles right now. Challenge a friend to start one."
                                Visibility="Collapsed" />
                            <ItemsControl x:Name="ActiveItems" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="16,14"
                                            Style="{StaticResource GameInset}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="{Binding StatusBrush}"
                                                        Text="{Binding StatusText}" />
                                                </Grid>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Text="You" />
                                                    <ProgressBar
                                                        Grid.Column="1"
                                                        Foreground="{StaticResource Brush.Gold}"
                                                        Style="{StaticResource VsBar}"
                                                        Value="{Binding MinePercent, Mode=OneWay}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        FontSize="13"
                                                        Text="{Binding MineText}" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{StaticResource Brush.GameMuted}"
                                                        Text="{Binding Opponent}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Foreground="{StaticResource Brush.Coral}"
                                                        Style="{StaticResource VsBar}"
                                                        Value="{Binding TheirsPercent, Mode=OneWay}" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        FontSize="13"
                                                        Foreground="{StaticResource Brush.GameMuted}"
                                                        Text="{Binding TheirsText}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>

                    <!--  Results  -->
                    <ContentControl Style="{StaticResource ArcadePanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.GameHeading}" Text="PAST BATTLES" />
                            <ItemsControl x:Name="PastItems" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Style="{StaticResource GameInset}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Style="{StaticResource Text.GameMuted}"
                                                        Text="{Binding DetailText}" />
                                                </StackPanel>
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Background="{Binding ResultBackground}"
                                                    Style="{StaticResource Pill}">
                                                    <TextBlock
                                                        FontSize="9"
                                                        Foreground="{StaticResource Brush.GameDeep}"
                                                        Style="{StaticResource Text.Pixel}"
                                                        Text="{Binding ResultText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!--  New challenge  -->
                    <ContentControl Margin="0,0,0,20" Style="{StaticResource ArcadePanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.GameHeading}" Text="CHALLENGE A FRIEND" />
                            <TextBlock
                                Margin="0,18,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Friend" />
                            <TextBox
                                x:Name="OpponentSearchTextBox"
                                MinHeight="34"
                                TextChanged="OpponentSearchTextBox_TextChanged" />

                            <ListBox
                                x:Name="OpponentResultsListBox"
                                MaxHeight="130"
                                Margin="0,6,0,0"
                                DisplayMemberPath="Username"
                                SelectionChanged="OpponentResultsListBox_SelectionChanged"
                                Visibility="Collapsed" />
                            <TextBlock
                                Margin="0,14,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Battle length" />
                            <ComboBox x:Name="LengthComboBox" SelectedIndex="1">
                                <ComboBoxItem Content="3 days" Tag="3" />
                                <ComboBoxItem Content="1 week" Tag="7" />
                                <ComboBoxItem Content="2 weeks" Tag="14" />
                            </ComboBox>
                            <Button
                                x:Name="SendChallengeButton"
                                Margin="0,22,0,0"
                                HorizontalAlignment="Stretch"
                                Click="SendChallengeButton_Click"
                                Content="SEND CHALLENGE"
                                IsEnabled="False"
                                Style="{StaticResource Button.Game}" />
                            <TextBlock
                                x:Name="SendStatusText"
                                Margin="0,12,0,0"
                                Style="{StaticResource Text.GameMuted}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ContentControl>

                    <!--  Sent challenges  -->
                    <ContentControl x:Name="WaitingPanel" Style="{StaticResource ArcadePanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.GameHeading}" Text="AWAITING REPLY" />
                            <ItemsControl x:Name="WaitingItems" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Style="{StaticResource GameInset}">
                                            <Grid>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding Opponent}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource Brush.GameMuted}"
                                                    Text="{Binding Days, StringFormat='{}{0}-day battle'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
