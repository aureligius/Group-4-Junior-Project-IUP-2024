<UserControl
    x:Class="CarbonKickers.Client.Views.Dashboard.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,16">

            <!--  Header  -->
            <TextBlock
                x:Name="WelcomeText"
                Style="{StaticResource Text.ScreenTitle}"
                Text="Welcome back"
                TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Your season so far, and what to play next." />

            <TextBlock
                x:Name="DashboardErrorText"
                Margin="0,16,0,0"
                Style="{StaticResource Text.Error}"
                Visibility="Collapsed" />

            <!--  Scoreboard: the one arcade band on this screen  -->
            <ContentControl
                Margin="0,16,0,0"
                Padding="28,20,28,0"
                Style="{StaticResource ArcadePanel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <!--  Who you are as a player  -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="30"
                                    Height="42"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    RenderOptions.EdgeMode="Aliased"
                                    Source="{StaticResource Sprite.Player}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="PlayerNameText"
                                        Style="{StaticResource Text.GameHeading}"
                                        Text="Player"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Rectangle
                                            x:Name="TierDot"
                                            Width="10"
                                            Height="10"
                                            Fill="{StaticResource Brush.Tier.Bronze}" />
                                        <TextBlock
                                            x:Name="TierText"
                                            Margin="8,0,0,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource Brush.GameText}"
                                            Text="Bronze league" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,22,0,10" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="GreenXpText"
                                    FontSize="32"
                                    Foreground="{StaticResource Brush.Gold}"
                                    LineHeight="36"
                                    Style="{StaticResource Text.Pixel}"
                                    Text="0" />
                                <TextBlock
                                    Margin="12,0,0,4"
                                    VerticalAlignment="Bottom"
                                    FontSize="10"
                                    Foreground="{StaticResource Brush.Gold}"
                                    Style="{StaticResource Text.Pixel}"
                                    Text="GREEN XP" />
                            </StackPanel>

                            <ProgressBar
                                x:Name="XpProgress"
                                Style="{StaticResource XpBar}"
                                Value="0" />

                            <Grid Margin="0,14,0,0">
                                <TextBlock FontSize="14" Foreground="{StaticResource Brush.GameMuted}">
                                    <Run
                                        x:Name="Co2SavedText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Brush.Peach}"
                                        Text="0.00 kg" />
                                    <Run Text="CO₂ kicked" />
                                    <Run Text="  ·  " />
                                    <Run
                                        x:Name="TotalTripsText"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Brush.Peach}"
                                        Text="0" />
                                    <Run Text="trips" />
                                </TextBlock>
                                <TextBlock
                                    x:Name="NextTierText"
                                    HorizontalAlignment="Right"
                                    FontSize="14"
                                    Style="{StaticResource Text.GameMuted}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </StackPanel>

                        <!--  Divider  -->
                        <Rectangle
                            Grid.Column="1"
                            Width="2"
                            HorizontalAlignment="Center"
                            Fill="{StaticResource Brush.GameDeep}" />

                        <!--  What to do next + your rewards  -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="LogTripButton_Click"
                                Content="LOG A TRIP"
                                Style="{StaticResource Button.Game}" />
                            <Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Click="TripHistoryButton_Click"
                                Content="View trip history"
                                Foreground="{StaticResource Brush.GameMuted}"
                                Style="{StaticResource Button.Link}" />

                            <Border
                                Margin="0,20,0,0"
                                Padding="12,10"
                                Style="{StaticResource GameInset}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        x:Name="LatestBadgesPanel"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ItemsControl x:Name="LatestBadgesItems" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,4,0"
                                                        RenderOptions.EdgeMode="Aliased"
                                                        Source="{StaticResource Sprite.Medal}"
                                                        ToolTip="{Binding Title}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            x:Name="BadgesSummaryText"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource Brush.GameText}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="NoBadgesText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.GameMuted}"
                                        Text="No badges yet"
                                        Visibility="Collapsed" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Click="BadgesButton_Click"
                                        Content="BADGES"
                                        Style="{StaticResource Button.GameGhostSmall}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!--  Scenery strip along the bottom of the band  -->
                    <Grid
                        Height="36"
                        Margin="-28,12,-28,0"
                        ClipToBounds="True">
                        <Rectangle
                            Height="24"
                            Margin="0,0,0,12"
                            VerticalAlignment="Bottom"
                            Opacity="0.55">
                            <Rectangle.Fill>
                                <ImageBrush
                                    ImageSource="{StaticResource Sprite.Skyline}"
                                    Stretch="Fill"
                                    TileMode="Tile"
                                    Viewport="0,0,64,24"
                                    ViewportUnits="Absolute" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle
                            Height="14"
                            VerticalAlignment="Bottom"
                            Fill="{StaticResource Brush.GameDeep}" />
                        <Rectangle
                            Height="3"
                            Margin="0,0,0,5"
                            VerticalAlignment="Bottom">
                            <Rectangle.Fill>
                                <DrawingBrush
                                    TileMode="Tile"
                                    Viewport="0,0,24,3"
                                    ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V3 H0 Z" />
                                            <GeometryDrawing Brush="#73F8D5B9" Geometry="M0,0 H12 V3 H0 Z" />
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image
                            Width="20"
                            Height="22"
                            Margin="0,0,90,12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            RenderOptions.EdgeMode="Aliased"
                            Source="{StaticResource Sprite.Tree}" />
                        <Image
                            Width="44"
                            Height="24"
                            Margin="64,0,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            RenderOptions.EdgeMode="Aliased"
                            Source="{StaticResource Sprite.Bike}" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!--  Calm row: progress and competition  -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="22,20" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Text.Heading}" Text="CO₂ kicked, last 7 days" />
                            <TextBlock
                                x:Name="WeekTotalText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                Foreground="{StaticResource Brush.TextMuted}" />
                        </Grid>

                        <!--  Fills the card's height; bars are a share of it  -->
                        <Grid MinHeight="190" Margin="0,22,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle
                                Height="1"
                                VerticalAlignment="Bottom"
                                Fill="{StaticResource Brush.Border}" />
                            <ItemsControl x:Name="DailyImpactItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="{Binding BarRest}" />
                                                <RowDefinition Height="{Binding BarFill}" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource Brush.Text}"
                                                Text="{Binding ValueLabel}"
                                                Visibility="{Binding ValueVisibility}" />
                                            <Rectangle
                                                Grid.Row="1"
                                                Width="24"
                                                Fill="{StaticResource Brush.Chart}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                x:Name="EmptyWeekText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Muted}"
                                Text="No trips in the last 7 days. Log one to get the bars moving."
                                Visibility="Collapsed" />
                            <ItemsControl
                                x:Name="DayLabelItems"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                IsTabStop="False"
                                ItemsSource="{Binding ItemsSource, ElementName=DailyImpactItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource Brush.TextMuted}"
                                            Text="{Binding DayLabel}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  Compete: everything from the activity diagram's competition branch  -->
                <Border
                    Grid.Column="2"
                    Padding="22,20"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Heading}"
                                Text="Compete" />

                        </Grid>

                        <!--  Status line with a compact join action  -->
                        <Grid Margin="0,10,0,12">
                            <TextBlock
                                x:Name="CompeteStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Muted}" />
                        </Grid>

                        <Button Click="LeaderboardTile_Click" Style="{StaticResource Button.ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Icon.Leaderboard}"
                                    Fill="{StaticResource Brush.Primary}"
                                    RenderOptions.EdgeMode="Aliased"
                                    Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="View leaderboard" />
                                    <TextBlock
                                        x:Name="LeaderboardTileText"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="LeagueTile_Click" Style="{StaticResource Button.ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Icon.League}"
                                    Fill="{StaticResource Brush.Primary}"
                                    RenderOptions.EdgeMode="Aliased"
                                    Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock
                                        x:Name="LeagueTileTitle"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Join weekly league" />
                                    <TextBlock
                                        x:Name="LeagueTileText"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Click="ArenaTile_Click" Style="{StaticResource Button.ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Icon.Arena}"
                                    Fill="{StaticResource Brush.Primary}"
                                    RenderOptions.EdgeMode="Aliased"
                                    Stretch="Uniform" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Challenge a friend" />
                                    <TextBlock
                                        x:Name="ArenaTileText"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
