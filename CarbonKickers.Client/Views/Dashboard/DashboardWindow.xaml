<Window x:Class="CarbonKickers.Client.Views.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carbon Kickers Dashboard"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F4F8F7">
            <StackPanel Margin="32">

                <TextBlock x:Name="WelcomeText"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#094A44"/>

                <TextBlock Text="Your sustainability impact"
                           Margin="0,4,0,24"
                           FontSize="16"
                           Foreground="#45726D"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,20">
                    <Button Content="Log a Trip"
                            Click="LogTripButton_Click"
                            Width="130"
                            Height="36"
                            Background="#45726D"
                            Foreground="White"/>

                    <Button Content="Trip History"
                            Click="TripHistoryButton_Click"
                            Width="130"
                            Height="36"
                            Margin="12,0,0,0"
                            Background="#094A44"
                            Foreground="White"/>
                </StackPanel>


                <UniformGrid Columns="3" Margin="0,0,0,28">
                    <Border Margin="0,0,12,0"
                            Padding="18"
                            Background="White"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Green XP"
                                       Foreground="#45726D"/>
                            <TextBlock x:Name="GreenXpText"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#094A44"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,12,0"
                            Padding="18"
                            Background="White"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="CO₂ Saved"
                                       Foreground="#45726D"/>
                            <TextBlock x:Name="Co2SavedText"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#094A44"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="18"
                            Background="White"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Trips Logged"
                                       Foreground="#45726D"/>
                            <TextBlock x:Name="TotalTripsText"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#094A44"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Last 7 Days"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#094A44"
                           Margin="0,0,0,10"/>

                <ItemsControl x:Name="DailyImpactItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TripCount, StringFormat={}{0} trip(s)}"/>

                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               Text="{Binding Co2SavedKg, StringFormat={}{0:F2} kg CO₂ saved}"
                                               Foreground="#094A44"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="DashboardErrorText"
                           Foreground="Crimson"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>