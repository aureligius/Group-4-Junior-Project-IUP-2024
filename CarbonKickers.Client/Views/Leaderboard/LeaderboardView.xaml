<UserControl x:Class="CarbonKickers.Client.Views.Leaderboard.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,36">
            <Grid>
                <TextBlock Text="LEADERBOARD" Style="{StaticResource Text.ScreenTitle}"/>
                <Border Style="{StaticResource PreviewTag}" HorizontalAlignment="Right">
                    <TextBlock Text="Preview · sample data" FontSize="12" Foreground="{StaticResource Brush.Danger}"/>
                </Border>
            </Grid>
            <TextBlock Text="Who's kicked the most CO₂. Your row uses your real Green XP; the other players are sample data."
                       Style="{StaticResource Text.Subtitle}"/>

            <ContentControl Style="{StaticResource ArcadePanel}" Margin="0,24,0,0">
                <StackPanel>
                    <!-- Not competing yet -->
                    <Border x:Name="JoinBanner" Style="{StaticResource GameInset}" Margin="0,0,0,18" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="You're not on the board yet." FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Join the competition to get ranked against other players."
                                           Style="{StaticResource Text.GameMuted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="JOIN COMPETITION" Style="{StaticResource Button.GameSmall}"
                                    VerticalAlignment="Center" Click="JoinButton_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="AllTimeTab" Content="ALL TIME" GroupName="Period" Style="{StaticResource GameTab}"
                                     IsChecked="True" Checked="PeriodTab_Checked"/>
                        <RadioButton x:Name="WeekTab" Content="THIS WEEK" GroupName="Period" Style="{StaticResource GameTab}"
                                     Margin="8,0,0,0" Checked="PeriodTab_Checked"/>
                    </StackPanel>

                    <!-- Column headings -->
                    <Grid Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rank" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                        <TextBlock Grid.Column="1" Text="Player" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                        <TextBlock Grid.Column="2" Text="Tier" FontSize="12" Foreground="{StaticResource Brush.GameMuted}"/>
                        <TextBlock x:Name="XpHeaderText" Grid.Column="3" Text="Green XP" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Brush.GameMuted}"/>
                        <TextBlock Grid.Column="4" Text="CO₂ kicked" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource Brush.GameMuted}"/>
                    </Grid>

                    <ItemsControl x:Name="RowsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}" BorderThickness="1" Padding="16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RankText}" Style="{StaticResource Text.Pixel}" Margin="0,3,0,0" FontSize="12"
                                                   Foreground="{Binding RankBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="{Binding NameWeight}"
                                                   Foreground="{StaticResource Brush.GameText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="10" Height="10" Fill="{Binding TierBrush}"/>
                                            <TextBlock Text="{Binding TierName}" Margin="8,0,0,0" FontSize="13"
                                                       Foreground="{StaticResource Brush.GameText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding XpText}" Style="{StaticResource Text.Pixel}" Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Co2Text}" FontSize="13" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.GameMuted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
