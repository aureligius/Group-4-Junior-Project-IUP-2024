<UserControl
    x:Class="CarbonKickers.Client.Views.Leaderboard.LeaderboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,36">
            <Grid>
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="LEADERBOARD" />

            </Grid>
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="This week's players ranked by CO₂ saved through greener trips." />

            <ContentControl Margin="0,24,0,0" Style="{StaticResource ArcadePanel}">
                <StackPanel>
                    <!--  Column headings  -->
                    <Grid Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="Rank" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="Player" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="Period" />
                        <TextBlock
                            x:Name="XpHeaderText"
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="Green XP" />
                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource Brush.GameMuted}"
                            Text="CO₂ kicked" />
                    </Grid>

                    <ItemsControl x:Name="RowsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="16,12"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="{Binding RowBorder}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{Binding RankBrush}"
                                            Style="{StaticResource Text.Pixel}"
                                            Text="{Binding RankText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="{Binding NameWeight}"
                                            Foreground="{StaticResource Brush.GameText}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Rectangle
                                                Width="10"
                                                Height="10"
                                                Fill="{Binding TierBrush}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="13"
                                                Foreground="{StaticResource Brush.GameText}"
                                                Text="{Binding TierName}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource Brush.Gold}"
                                            Style="{StaticResource Text.Pixel}"
                                            Text="{Binding XpText}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource Brush.GameMuted}"
                                            Text="{Binding Co2Text}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <TextBlock
                x:Name="ErrorText"
                Margin="0,16,0,0"
                Style="{StaticResource Text.Error}"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
