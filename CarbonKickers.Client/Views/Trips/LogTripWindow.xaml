<Window x:Class="CarbonKickers.Client.Views.Trips.LogTripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log a Trip"
        Height="720"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#F4F8F7">
            <Border Margin="28"
                    Padding="28"
                    Background="White"
                    CornerRadius="14">
                <StackPanel>

                    <TextBlock Text="Log a Trip"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#094A44"/>

                    <TextBlock Text="Select exact locations to calculate your carbon impact."
                               Margin="0,6,0,24"
                               Foreground="#45726D"/>

                    <TextBlock Text="Origin"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="OriginTextBox"
                             TextChanged="OriginTextBox_TextChanged"
                             Height="34"
                             Margin="0,6,0,4"/>

                    <ListBox x:Name="OriginSuggestionsListBox"
                             SelectionChanged="OriginSuggestionsListBox_SelectionChanged"
                             Height="110"
                             Visibility="Collapsed"
                             Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FormattedAddress}"
                                            FontSize="12"
                                            Foreground="#45726D"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>  

                    <TextBlock Text="Destination"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="DestinationTextBox"
                             TextChanged="DestinationTextBox_TextChanged"
                             Height="34"
                             Margin="0,6,0,4"/>

                    <ListBox x:Name="DestinationSuggestionsListBox"
                            SelectionChanged="DestinationSuggestionsListBox_SelectionChanged"
                            Height="110"
                            Visibility="Collapsed"
                            Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FormattedAddress}"
                                            FontSize="12"
                                            Foreground="#45726D"
                                            TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Transport Used"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="TransportModeComboBox"
                              DisplayMemberPath="Name"
                              Height="34"
                              Margin="0,6,0,16"/>

                    <TextBlock Text="Compare Against"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="BaselineModeComboBox"
                              DisplayMemberPath="Name"
                              Height="34"
                              Margin="0,6,0,20"/>

                    <Button x:Name="SaveTripButton"
                            Content="Save Trip"
                            Click="SaveTripButton_Click"
                            Height="40"
                            Background="#45726D"
                            Foreground="White"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="Crimson"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,14,0,0"/>

                    <Border x:Name="ResultBorder"
                            Visibility="Collapsed"
                            Background="#E6F4EF"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Trip saved!"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="#094A44"/>

                                <TextBlock x:Name="DistanceResultText"
                                        Margin="0,10,0,0"/>

                                <TextBlock x:Name="BaselineDistanceResultText"
                                        Margin="0,4,0,0"/>

                                <TextBlock x:Name="EmittedResultText"
                                        Margin="0,10,0,0"/>

                                <TextBlock x:Name="BaselineEmittedResultText"
                                        Margin="0,4,0,0"/>

                                <TextBlock x:Name="SavedResultText"
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="#094A44"/>

                                <TextBlock x:Name="XpResultText"
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="#094A44"/>

                                <TextBlock x:Name="RouteEstimateText"
                                        Margin="0,10,0,0"
                                        Foreground="#8A5A00"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>