<UserControl x:Class="CarbonKickers.Client.Views.Trips.TripHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="36,32,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="TRIP HISTORY" Style="{StaticResource Text.ScreenTitle}"/>
                <TextBlock x:Name="SummaryText" Text="Your latest trips and their carbon impact."
                           Style="{StaticResource Text.Subtitle}"/>
            </StackPanel>
            <Button Content="LOG A TRIP" Style="{StaticResource Button.GameSmall}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Click="LogTripButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid x:Name="TripsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Date" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LoggedAt, StringFormat='{}{0:d MMM yyyy}'}"/>
                                    <TextBlock Text="{Binding LoggedAt, StringFormat='{}{0:HH:mm}'}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Origin and destination share one column so neither gets squeezed -->
                    <DataGridTemplateColumn Header="Route" Width="*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Origin}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Origin}"/>
                                    <TextBlock Text="{Binding Destination, StringFormat='to {0}'}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Destination}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Transport" Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TransportModeName}"/>
                                    <TextBlock Text="{Binding BaselineTransportModeName, StringFormat='vs {0}'}" FontSize="12"
                                               Margin="0,2,0,0" Foreground="{StaticResource Brush.TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Distance" Width="86"
                                        Binding="{Binding DistanceKm, StringFormat={}{0:F2} km}"/>
                    <DataGridTextColumn Header="Usual route" Width="96"
                                        Binding="{Binding BaselineDistanceKm, StringFormat={}{0:F2} km}"/>
                    <DataGridTextColumn Header="CO₂ kicked" Width="96"
                                        Binding="{Binding Co2SavedKg, StringFormat={}{0:F2} kg}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="XP" Binding="{Binding XpEarned, StringFormat={}+{0}}" Width="64"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="No trips logged yet." Style="{StaticResource Text.Heading}" HorizontalAlignment="Center"/>
                <TextBlock Text="Your first trip shows up here with its distance, CO₂ kicked and XP."
                           Style="{StaticResource Text.Muted}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                <Button Content="LOG YOUR FIRST TRIP" Style="{StaticResource Button.Game}" HorizontalAlignment="Center"
                        Click="LogTripButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
