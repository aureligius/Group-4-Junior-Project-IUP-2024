<Window x:Class="CarbonKickers.Client.Views.Trips.TripHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trip History"
        Height="650"
        Width="1150"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#F4F8F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="28,28,28,16">
            <TextBlock Text="Trip History"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#094A44"/>

            <TextBlock Text="Your latest trips and their carbon impact."
                       Margin="0,5,0,0"
                       Foreground="#45726D"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="28,0,28,28">
            <DataGrid x:Name="TripsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F7FAF9">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding LoggedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Origin"
                                        Binding="{Binding Origin}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Destination"
                                        Binding="{Binding Destination}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Transport"
                                        Binding="{Binding TransportModeName}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Actual Distance"
                                        Binding="{Binding DistanceKm, StringFormat={}{0:F2} km}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Car/Baseline Distance"
                                        Binding="{Binding BaselineDistanceKm, StringFormat={}{0:F2} km}"
                                        Width="135"/>

                    <DataGridTextColumn Header="CO₂ Saved"
                                        Binding="{Binding Co2SavedKg, StringFormat={}{0:F2} kg}"
                                        Width="100"/>

                    <DataGridTextColumn Header="XP"
                                        Binding="{Binding XpEarned}"
                                        Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText"
                       Text="No trips logged yet. Start by logging your first trip."
                       FontSize="16"
                       Foreground="#45726D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="Crimson"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>