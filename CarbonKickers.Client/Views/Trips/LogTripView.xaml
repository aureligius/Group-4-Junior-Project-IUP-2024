<UserControl x:Class="CarbonKickers.Client.Views.Trips.LogTripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="PlaceTemplate">
            <StackPanel Margin="2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{Binding FormattedAddress}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!-- A sparkle that twinkles once when the badge appears -->
        <Style x:Key="Sparkle" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource Sprite.Sparkle}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
            <StackPanel x:Name="PageHeader" Margin="0,0,0,24">
                <TextBlock Text="LOG A TRIP" Style="{StaticResource Text.ScreenTitle}"/>
                <TextBlock Text="Pick exact places so we can measure your route and the one you'd normally take."
                           Style="{StaticResource Text.Subtitle}"/>
            </StackPanel>

            <!-- Fills the page: holds the form or the payout -->
            <Grid>
                <!-- Form: calm -->
                <Border x:Name="FormCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Where did you go?" Style="{StaticResource Text.Heading}" Margin="0,0,0,18"/>

                        <!-- From and To side by side, each with its own suggestions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="From" Style="{StaticResource Text.Label}"/>
                                <TextBox x:Name="OriginTextBox" TextChanged="OriginTextBox_TextChanged"/>
                                <ListBox x:Name="OriginSuggestionsListBox" Style="{StaticResource SuggestionList}"
                                         SelectionChanged="OriginSuggestionsListBox_SelectionChanged" MaxHeight="150"
                                         Visibility="Collapsed" Margin="0,4,0,0" ItemTemplate="{StaticResource PlaceTemplate}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To" Style="{StaticResource Text.Label}"/>
                                <TextBox x:Name="DestinationTextBox" TextChanged="DestinationTextBox_TextChanged"/>
                                <ListBox x:Name="DestinationSuggestionsListBox" Style="{StaticResource SuggestionList}"
                                         SelectionChanged="DestinationSuggestionsListBox_SelectionChanged" MaxHeight="150"
                                         Visibility="Collapsed" Margin="0,4,0,0" ItemTemplate="{StaticResource PlaceTemplate}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Type at least 3 letters, then pick a suggestion." Style="{StaticResource Text.Muted}"
                                   FontSize="12" Margin="0,6,0,0"/>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="How you travelled" Style="{StaticResource Text.Label}"/>
                                <ComboBox x:Name="TransportModeComboBox" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Your usual ride" Style="{StaticResource Text.Label}"/>
                                <ComboBox x:Name="BaselineModeComboBox" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Your CO₂ saving is measured against your usual ride. Greener than usual earns Green XP."
                                   Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,8,0,24"/>

                        <Button x:Name="SaveTripButton" Content="SAVE TRIP" Style="{StaticResource Button.Game}"
                                HorizontalAlignment="Stretch" Click="SaveTripButton_Click"/>

                        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Error}" Visibility="Collapsed"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- After saving: the payout screen replaces the form -->
                <ContentControl x:Name="ResultBorder" Style="{StaticResource ArcadePanel}"
                                Visibility="Collapsed" Padding="28,20" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <ScaleTransform x:Name="ResultScale" ScaleX="1" ScaleY="1"/>
                    </ContentControl.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="TRIP COMPLETE!" Style="{StaticResource Text.Pixel}" FontSize="24" LineHeight="32"
                                   Foreground="{StaticResource Brush.Peach}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RouteSummaryText" Style="{StaticResource Text.GameMuted}" FontSize="14"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>

                        <!-- The two numbers that matter, counting up -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="XpResultText" Text="+0" Style="{StaticResource Text.Pixel}" FontSize="40"
                                           LineHeight="48" Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Green XP earned" Style="{StaticResource Text.GameMuted}" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="SavedResultText" Text="0.00" Style="{StaticResource Text.Pixel}" FontSize="40"
                                           LineHeight="48" Foreground="{StaticResource Brush.Peach}" HorizontalAlignment="Center"/>
                                <TextBlock Text="kg of CO₂ kicked" Style="{StaticResource Text.GameMuted}" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Gained XP shows in peach underneath; the gold fill then catches up -->
                        <Grid x:Name="TierBar" Margin="0,18,0,0">
                            <ProgressBar x:Name="TierGain" Style="{StaticResource XpBar}"
                                         Foreground="{StaticResource Brush.XpSegmentsGained}"/>
                            <ProgressBar x:Name="TierProgress" Style="{StaticResource XpBarFill}"/>
                        </Grid>
                        <TextBlock x:Name="TierProgressText" Style="{StaticResource Text.GameMuted}" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <!-- Badges unlocked by this trip: space is reserved on entry, then they pop in -->
                        <ItemsControl x:Name="NewBadgesItems" Margin="0,16,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GameInset}" Padding="18,10" Margin="0,0,0,0"
                                            BorderBrush="{StaticResource Brush.Gold}" BorderThickness="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="98" Height="78" HorizontalAlignment="Center">
                                                <Image Source="{StaticResource Sprite.Medal}" Width="70" Height="70"
                                                       RenderOptions.EdgeMode="Aliased"/>
                                                <Image Style="{StaticResource Sparkle}" Width="21" Height="21"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Image.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.15"/>
                                                                        <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0.4"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                                <Image Style="{StaticResource Sparkle}" Width="14" Height="14"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Image.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard BeginTime="0:0:0.08">
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.15"/>
                                                                        <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0.4"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                                <Image Style="{StaticResource Sparkle}" Width="14" Height="14" Margin="8,0,0,4"
                                                       HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                    <Image.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard BeginTime="0:0:0.16">
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                        <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.15"/>
                                                                        <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0.4"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Image.Triggers>
                                                </Image>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Text.Pixel}" FontSize="16" LineHeight="24" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Brush.Gold}">
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                <Run Text="UNLOCKED!" Foreground="{StaticResource Brush.Peach}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.GameMuted}"
                                                       FontSize="14" Margin="0,6,0,0" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button x:Name="LogAnotherButton" Content="LOG ANOTHER TRIP" Style="{StaticResource Button.Game}"
                                    Click="LogAnotherButton_Click"/>
                            <Button Content="BACK TO DASHBOARD" Style="{StaticResource Button.GameGhost}" Margin="16,0,0,0"
                                    Click="BackToDashboardButton_Click"/>
                        </StackPanel>

                        <!-- Route details as the footer, quieter -->
                        <Border Style="{StaticResource GameInset}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DistanceResultText" Foreground="{StaticResource Brush.GameText}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="EmittedResultText" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.GameText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="BaselineDistanceResultText" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.GameMuted}"/>
                                        <TextBlock x:Name="BaselineEmittedResultText" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.GameMuted}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="RouteEstimateText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource Brush.Coral}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
