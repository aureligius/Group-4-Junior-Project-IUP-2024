<Window x:Class="CarbonKickers.Client.Views.Badges.MyBadgesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Badges"
        Height="550"
        Width="620"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#F4F8F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="28,28,28,16">
            <TextBlock Text="My Badges"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#094A44"/>

            <TextBlock Text="Your unlocked Carbon Kickers achievements."
                       Margin="0,5,0,0"
                       Foreground="#45726D"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="28,0,28,28">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BadgesItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding IconUrl}"
                                               FontSize="30"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#094A44"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="#45726D"/>

                                        <TextBlock Text="{Binding XpRequirement, StringFormat={}{0} XP required}"
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   Foreground="#6A8A85"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UnlockedAt, StringFormat={}{0:dd MMM yyyy}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#45726D"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Text="No badges unlocked yet. Log a trip to earn your first badge!"
                       FontSize="16"
                       Foreground="#45726D"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="Crimson"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>