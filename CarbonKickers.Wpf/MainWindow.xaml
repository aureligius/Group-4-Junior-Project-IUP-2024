<Window x:Class="CarbonKickers.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carbon Kickers"
        Height="560"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#094A44">
        <Border Width="350"
                Padding="30"
                Background="White"
                CornerRadius="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Grid>
                <!-- Login screen -->
                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="Carbon Kickers"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#094A44"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Welcome back!"
                               Margin="0,12,0,24"
                               FontSize="16"
                               Foreground="#45726D"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Email Address"/>
                    <TextBox x:Name="LoginEmailTextBox"
                             Height="32"
                             Margin="0,6,0,16"/>

                    <TextBlock Text="Password"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Height="32"
                                 Margin="0,6,0,20"/>

                    <TextBlock x:Name="LoginErrorText"
                               Foreground="Crimson"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"/>

                    <Button Content="Log In"
                            Click="LoginButton_Click"
                            Height="38"
                            Background="#45726D"
                            Foreground="White"/>

                    <Button Content="Don't have an account? Sign up"
                            Click="ShowRegisterButton_Click"
                            Margin="0,16,0,0"
                            Background="Transparent"
                            Foreground="#45726D"
                            BorderThickness="0"/>
                </StackPanel>

                <!-- Register screen -->
                <StackPanel x:Name="RegisterPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Create an Account"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#094A44"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Start kicking carbon."
                               Margin="0,12,0,24"
                               FontSize="16"
                               Foreground="#45726D"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Username"/>
                    <TextBox x:Name="RegisterUsernameTextBox"
                             Height="32"
                             Margin="0,6,0,12"/>

                    <TextBlock Text="Email Address"/>
                    <TextBox x:Name="RegisterEmailTextBox"
                             Height="32"
                             Margin="0,6,0,12"/>

                    <TextBlock Text="Password"/>
                    <PasswordBox x:Name="RegisterPasswordBox"
                                 Height="32"
                                 Margin="0,6,0,20"/>

                    <TextBlock x:Name="RegisterErrorText"
                               Foreground="Crimson"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"/>

                    <Button Content="Create Account"
                            Click="RegisterButton_Click"
                            Height="38"
                            Background="#F7AB9B"
                            Foreground="White"/>

                    <Button Content="Already have an account? Log in"
                            Click="ShowLoginButton_Click"
                            Margin="0,16,0,0"
                            Background="Transparent"
                            Foreground="#45726D"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>